pipeline {
    agent any

    tools {
        jdk 'jdk17'
        nodejs 'node23'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        DOCKER_IMAGE = 'reshma6540/zomato:latest'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Git Checkout') {
            steps {

                checkout scmGit(
                    branches: [[name: '*/master']],
                    extensions: [],
                    userRemoteConfigs: [[
                        credentialsId: 'github_creds',
                        url: 'https://github.com/Reshma-0654/DevOps-Project-Zomato-Kastro.git'
                    ]]
                )

                sh '''
                pwd
                ls -la
                '''
            }
        }

        stage('Install Dependencies') {
            steps {

                sh '''
                echo "Installing dependencies..."

                rm -rf node_modules

                npm install
                '''
            }
        }

        stage('Run Test Coverage') {
            steps {

                sh '''
                echo "Running test coverage..."

                npm test -- --coverage --watchAll=false --passWithNoTests || true
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {

                withSonarQubeEnv('sonar-server') {

                    sh '''
                    echo "Running SonarQube Scan..."

                    $SCANNER_HOME/bin/sonar-scanner \
                    -Dsonar.projectName=zomato \
                    -Dsonar.projectKey=zomato \
                    -Dsonar.sources=src \
                    -Dsonar.exclusions=node_modules/** \
                    -Dsonar.coverage.exclusions=src/**
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo "Skipping Quality Gate"
            }
        }

        stage('Trivy File Scan') {
            steps {

                sh '''
                echo "Running Trivy Scan..."

                trivy fs . > trivy.txt
                '''
            }
        }

        stage('Build Docker Image') {
            steps {

                sh '''
                echo "Building Docker image..."

                docker build -t zomato .
                '''
            }
        }

        stage('Tag & Push Docker Image') {
            steps {

                script {

                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {

                        sh '''
                        echo "Tagging image..."

                        docker tag zomato reshma6540/zomato:latest

                        echo "Pushing image..."

                        docker push reshma6540/zomato:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy Container') {
            steps {

                sh '''
                echo "Stopping old container..."

                docker stop zomato || true
                docker rm zomato || true

                echo "Running new container..."

                docker run -d \
                --name zomato \
                -p 3000:3000 \
                reshma6540/zomato:latest
                '''
            }
        }
    }

    post {

        always {

            emailext(
                attachLog: true,
                subject: "${currentBuild.currentResult}: ${env.JOB_NAME}",
                body: """
                <html>
                <body>

                <h2>Jenkins Pipeline Report</h2>

                <p><b>Project:</b> ${env.JOB_NAME}</p>

                <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>

                <p><b>Status:</b> ${currentBuild.currentResult}</p>

                <p><b>Build URL:</b> ${env.BUILD_URL}</p>

                </body>
                </html>
                """,
                to: 'kastrokiran@gmail.com',
                mimeType: 'text/html',
                attachmentsPattern: 'trivy.txt'
            )
        }
    }
}
