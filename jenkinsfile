pipeline {
    agent any

    tools {
        jdk 'jdk17'
        nodejs 'node23'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        DOCKER_IMAGE = 'kastrov/zomato:latest'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Git Checkout') {
            steps {

                checkout scmGit(
                    branches: [[name: '*/master']],
                    extensions: [],
                    userRemoteConfigs: [[
                        credentialsId: 'github_creds',
                        url: 'https://github.com/Reshma-0654/DevOps-Project-Zomato-Kastro.git'
                    ]]
                )

                sh '''
                echo "Current Directory:"
                pwd

                echo "Workspace Files:"
                ls -la
                '''
            }
        }

        stage('Install Dependencies') {
            steps {

                sh '''
                echo "Installing NPM dependencies..."

                rm -rf node_modules package-lock.json

                npm install
                '''
            }
        }

        stage('Run Test Coverage') {
            steps {

                sh '''
                echo "Running React test coverage..."

                npm run test:coverage -- --watchAll=false || true
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {

                withSonarQubeEnv('sonar-server') {

                    sh '''
                    echo "Starting SonarQube Scan..."

                    $SCANNER_HOME/bin/sonar-scanner \
                    -Dsonar.projectName=zomato \
                    -Dsonar.projectKey=zomato \
                    -Dsonar.sources=src \
                    -Dsonar.tests=src \
                    -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {

                timeout(time: 10, unit: 'MINUTES') {

                    script {

                        def qg = waitForQualityGate()

                        if (qg.status != 'OK') {

                            error "Pipeline aborted due to Quality Gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {

                dependencyCheck(
                    additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                    odcInstallation: 'DP-Check'
                )

                dependencyCheckPublisher(
                    pattern: '**/dependency-check-report.xml'
                )
            }
        }

        stage('Trivy File Scan') {
            steps {

                sh '''
                echo "Running Trivy filesystem scan..."

                trivy fs . > trivy.txt
                '''
            }
        }

        stage('Build Docker Image') {
            steps {

                sh '''
                echo "Building Docker image..."

                docker build -t zomato .
                '''
            }
        }

        stage('Tag & Push Docker Image') {
            steps {

                script {

                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {

                        sh '''
                        echo "Tagging Docker image..."

                        docker tag zomato $DOCKER_IMAGE

                        echo "Pushing Docker image..."

                        docker push $DOCKER_IMAGE
                        '''
                    }
                }
            }
        }

        stage('Docker Scout Scan') {
            steps {

                sh '''
                echo "Docker Scout Quickview"

                docker-scout quickview $DOCKER_IMAGE

                echo "Docker Scout CVEs"

                docker-scout cves $DOCKER_IMAGE

                echo "Docker Scout Recommendations"

                docker-scout recommendations $DOCKER_IMAGE
                '''
            }
        }

        stage('Deploy Container') {
            steps {

                sh '''
                echo "Stopping old container if exists..."

                docker stop zomato || true

                docker rm zomato || true

                echo "Running new container..."

                docker run -d \
                --name zomato \
                -p 3000:3000 \
                $DOCKER_IMAGE
                '''
            }
        }
    }

    post {

        success {

            echo 'Pipeline executed successfully!'
        }

        failure {

            echo 'Pipeline failed!'
        }

        always {

            emailext(
                attachLog: true,
                subject: "${currentBuild.currentResult}: ${env.JOB_NAME}",
                body: """
                <html>
                <body>

                    <h2>Jenkins Pipeline Report</h2>

                    <div style="background-color:#FFA07A;padding:10px;margin-bottom:10px;">
                        <p style="color:white;font-weight:bold;">
                            Project: ${env.JOB_NAME}
                        </p>
                    </div>

                    <div style="background-color:#90EE90;padding:10px;margin-bottom:10px;">
                        <p style="color:white;font-weight:bold;">
                            Build Number: ${env.BUILD_NUMBER}
                        </p>
                    </div>

                    <div style="background-color:#87CEEB;padding:10px;margin-bottom:10px;">
                        <p style="color:white;font-weight:bold;">
                            Build URL: ${env.BUILD_URL}
                        </p>
                    </div>

                    <div style="background-color:#DDA0DD;padding:10px;">
                        <p style="color:white;font-weight:bold;">
                            Build Status: ${currentBuild.currentResult}
                        </p>
                    </div>

                </body>
                </html>
                """,
                to: 'kastrokiran@gmail.com',
                mimeType: 'text/html',
                attachmentsPattern: 'trivy.txt'
            )
        }
    }
}
